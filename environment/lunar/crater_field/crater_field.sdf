<?xml version="1.0"?>
<sdf version="1.8">
    <world name="crater_field">
        <gravity>0 0 -1.62</gravity>
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
        <physics name="lunar_physics" type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000.0</real_time_update_rate>
        </physics>
        <light name="sun" type="directional">
            <!-- Harsh lunar lighting: low sun for long contrasty
                 shadows (airless Moon); near-white diffuse, almost no
                 specular (matte regolith). Keep some elevation so
                 shadowed faces stay barely visible to the LocCam. -->
            <direction>-0.85 0.35 -0.40</direction>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <attenuation>
                <range>1000</range>
            </attenuation>
        </light>
        <scene>
            <!-- Very low ambient: lunar shadows are near-black with no
                 atmosphere to scatter fill light. A small residual keeps
                 shadowed terrain barely readable for visual odometry. -->
            <ambient>0.08 0.08 0.08 1</ambient>
            <background>0.1 0.1 0.2 1</background>
            <shadows>true</shadows>
        </scene>
        <model name="lunar_ground">
            <static>true</static>

            <link name="ground_link">

                <!-- Lunar environment collision -->
                <collision name="ground_collision">
                    <geometry>
                        <mesh>
                            <uri>meshes/lunar_crater_environment.glb</uri>
                        </mesh>
                    </geometry>

                    <surface>
                        <friction>
                            <ode>
                                <mu>0.6</mu>
                                <mu2>0.6</mu2>

                                <!-- Tangential slip -->
                                <slip1>0.01</slip1>
                                <slip2>0.01</slip2>
                            </ode>
                        </friction>

                        <contact>
                            <ode>
                                <kp>1.0e6</kp>
                                <kd>1.0e3</kd>
                            </ode>
                        </contact>
                    </surface>
                </collision>

                <!-- Lunar environment visual -->
                <visual name="lunar_environment_visual">
                    <geometry>
                        <mesh>
                            <uri>meshes/lunar_crater_environment.glb</uri>
                        </mesh>
                    </geometry>
                </visual>

            </link>
        </model>
        <!-- Foreground rock scatter: the terrain GLB carries geometry
             but a single untextured material, so the smooth foreground
             gives the LocCam almost no corners. These small angular
             rocks (varied matte-grey diffuse albedos) sit in the camera's
             1-6 m foreground, clear of the +X drive corridor (|y| < 0.7
             kept free), each z seated from the mesh surface (seed 73).
             Visual and collision geometry match; static. -->
        <model name="foreground_rocks">
            <static>true</static>
            <link name="rock_00">
                <pose>3.362 1.701 0.139 0 0 0.690</pose>
                <collision name="rock_00_collision">
                    <geometry>
                        <box>
                            <size>0.099 0.099 0.069</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="rock_00_visual">
                    <geometry>
                        <box>
                            <size>0.099 0.099 0.069</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.25 0.24 0.23 1</ambient>
                        <diffuse>0.25 0.24 0.23 1</diffuse>
                    </material>
                </visual>
            </link>
            <link name="rock_01">
